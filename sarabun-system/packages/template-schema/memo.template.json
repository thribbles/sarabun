{
  "documentTypeCode": "memo",
  "name": "บันทึกข้อความ",
  "version": 1,
  "pageSize": "A4",
  "margins": { "top": "2.5cm", "left": "3cm", "right": "2cm", "bottom": "2cm" },
  "font": { "family": "TH Sarabun New", "size": "16pt", "lineHeight": 1 },
  "headerConfig": {
