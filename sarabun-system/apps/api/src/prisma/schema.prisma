generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  users     User[]
  documents Document[]
  createdAt DateTime @default(now())
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // ADMIN, AUTHOR, REVIEWER, VIEWER
  users User[]
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  passwordHash      String
  fullName          String
  position          String?
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  roleId            Int?
  role              Role?     @relation(fields: [roleId], references: [id])
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  createdTemplates  DocumentTemplate[]
  createdDocuments  Document[]
  logs              DocumentLog[]
  revisions         DocumentRevision[]
}

model DocumentType {
  id        Int      @id @default(autoincrement())
  code      String   @unique // external, internal, memo, stamped, attachment
  name      String
  templates DocumentTemplate[]
  documents Document[]
}

model DocumentTemplate {
  id             String   @id @default(uuid())
  documentTypeId Int
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  name           String
  version        Int      @default(1)
  pageSize       String   @default("A4")
  margins        Json     // {top,left,right,bottom}
  font           Json     // {family,size,lineHeight}
  headerConfig   Json?
  footerConfig   Json?
  fieldsSchema   Json     // ตามข้อ 3 ใน architecture.md
  layoutRules    Json     // ตามข้อ 2 ใน architecture.md
  isActive       Boolean  @default(true)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  documents      Document[]

  @@unique([documentTypeId, version])
}

model Document {
  id             String   @id @default(uuid())
  documentNo     String?
  documentTypeId Int
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  templateId     String?
  template       DocumentTemplate? @relation(fields: [templateId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  subject        String
  toPerson       String?
  reference      String?
  status         String   @default("DRAFT") // DRAFT/REVIEW/APPROVED/PRINTED/CANCELLED
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contents    DocumentContent[]
  signers     DocumentSigner[]
  attachments DocumentAttachment[]
  revisions   DocumentRevision[]
  logs        DocumentLog[]
}

model DocumentContent {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    Json     // TipTap JSON
  version    Int
  createdAt  DateTime @default(now())
}

model DocumentSigner {
  id           String    @id @default(uuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name         String
  position     String?
  signatureUrl String?
  signedAt     DateTime?
}

model DocumentAttachment {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    BigInt?
  uploadedById String?
  uploadedAt   DateTime @default(now())
}

model DocumentRevision {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  contentVersion Int
  note           String?
  changedById    String?
  changedBy      User?    @relation(fields: [changedById], references: [id])
  createdAt      DateTime @default(now())
}

model DocumentLog {
  id         BigInt   @id @default(autoincrement())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // CREATE/UPDATE/APPROVE/PRINT/EXPORT_PDF/CANCEL
  ipAddress  String?
  result     String?
  createdAt  DateTime @default(now())
}
